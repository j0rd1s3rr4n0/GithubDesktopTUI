; -----------------------------------------------------------------------------
; Supply-chain hardening (see supplychain.md)
; - Registry is pinned to the public npm registry (no mirror / proxy fallback).
; - Audit on install: fails loudly on known-vulnerable dependency trees.
; - engine-strict: refuses to install on unsupported Node.js versions.
; - Lockfile required: installs must reproduce the exact pinned tree.
; - Never publish this package (private = true equivalent).
; -----------------------------------------------------------------------------

registry=https://registry.npmjs.org/
audit=true
fund=false
engine-strict=true
package-lock=true
save-exact=true
strict-ssl=true
omit=dev
