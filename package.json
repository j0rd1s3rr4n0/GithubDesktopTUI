{
  "name": "git-desktop-tui",
  "version": "1.0.0",
  "description": "GitHub Desktop for your terminal - A modern TUI Git client",
  "main": "src/ui/app.js",
  "bin": {
    "gitu": "./bin/gitu.js",
    "gd": "./bin/gitu.js",
    "ghtui": "./bin/gitu.js"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bin/gitu.js",
    "test": "node --check bin/gitu.js",
    "verify:supplychain": "node scripts/verify-supply-chain.mjs verify",
    "supplychain:update": "node scripts/verify-supply-chain.mjs update",
    "supplychain:audit": "node scripts/verify-supply-chain.mjs audit"
  },
  "keywords": [
    "git",
    "tui",
    "github-desktop",
    "terminal",
    "blessed",
    "cli"
  ],
  "author": "Jordi Serrano (j0rd1s3rr4n0)",
  "license": "MIT",
  "dependencies": {
    "blessed": "^0.1.81",
    "simple-git": "^3.27.0"
  }
}
